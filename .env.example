# Copy this file to .env.local and replace the placeholder values.
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
APPROVAL_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MARKET_DATA_PROVIDER=demo
# Set to yahoo or twelve_data to use an external quote and historical data feed.
# Twelve Data requires TWELVE_DATA_API_KEY. Quotes may be delayed by provider plan.
# Market data configuration does not enable live brokerage execution.
TWELVE_DATA_API_KEY=


